---
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { legal } from '../../i18n/legal';
import { courseSync, caseStudyPath } from '../../data/work';

// Procurement-facing capabilities page (PLAN D1). Copy source: findings §4.4,
// restructured to remove em dashes (site voice rule). Positioning per the PLAN
// "POSITIONING CORRECTION": owner-led provider with direct technical
// responsibility; the edge is the inspectable working demonstrator. AI is NOT a
// value proposition and is not named here. Entity facts come from src/i18n/legal.ts
// (register fact = Amtsgericht München; the bridge sentence and (haftungsbeschränkt)
// are sourced once from that constant).

const practiceAreas: { title: string; body: string; link?: { href: string; text: string } }[] = [
  {
    title: 'Anwendungsentwicklung für Web und iOS',
    body: 'Webanwendungen und native iOS-Apps, von der Datenbank bis zur Oberfläche.',
  },
  {
    title: 'Interne Werkzeuge',
    body: 'Software für Arbeit, die Ihr Team heute von Hand oder in Tabellen erledigt.',
  },
  {
    title: 'Datenpipelines',
    body: 'Daten aus den Systemen holen, in denen sie liegen, sie aufbereiten und aktuell halten.',
  },
  {
    title: 'Integrationsarbeit',
    body: 'Neue Software an die Systeme und Schnittstellen anbinden, die Sie bereits betreiben.',
  },
  {
    title: 'Automatisierung mit Make.com',
    body: 'Make.com-Szenarien zwischen Werkzeugen, die ein Betrieb schon nutzt, etwa einem Buchungssystem, einem CRM und einer Tabelle. Ich teste sie, indem ich sie in einem echten Make-Konto laufen lasse.',
    link: { href: caseStudyPath(courseSync, 'de'), text: 'Beispiel: Kursanmeldungen von MindBody nach HubSpot' },
  },
];

const notOffered = [
  'Schulungen und Workshops',
  'Entwicklerüberlassung in fremden Prozessen',
  'Große Integrationsprojekte, besetzt mit Profilen von Personen, die nicht mitarbeiten',
  'Hardware-Beschaffung',
];
---

<Layout
  pageKey="leistungen"
  title="Leistungen · 9592 Solutions"
  description="Individuelle Software für Auftraggeber mit förmlichem Vergabeverfahren. Ein Entwickler, Direktvertrag, EU/DE-Datenschutz, WCAG 2.1 AA."
>
  <main id="main" class="max-w-3xl mx-auto px-6 py-16 md:py-20">
    <!-- Header -->
    <section class="mb-16">
      <p class="font-mono text-sm text-text-secondary mb-3 uppercase tracking-wider">Leistungen</p>
      <h1 class="text-3xl md:text-4xl font-semibold text-text-primary leading-tight mb-6">
        Lauffähige Software, auf Ihren Prozess zugeschnitten
      </h1>
      <p class="text-lg text-text-secondary leading-relaxed">
        Die {legal.legalName} ist mein Unternehmen, und die technische Arbeit mache
        ich selbst. Die zentralen Teile des angefragten Systems können Sie öffnen und
        prüfen, bevor Sie den Zuschlag erteilen.
      </p>
    </section>

    <!-- Tätigkeitsfelder -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">Tätigkeitsfelder</h2>
      <ul class="grid sm:grid-cols-2 gap-px bg-bg-secondary rounded-lg overflow-hidden border border-bg-secondary">
        {practiceAreas.map((area) => (
          <li class={`bg-bg-primary p-5${area.link ? ' sm:col-span-2' : ''}`}>
            <h3 class="text-text-primary font-medium mb-1">{area.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{area.body}</p>
            {area.link && (
              <a href={area.link.href} class="inline-flex items-center gap-2 text-accent hover:text-accent-hover transition-colors text-sm mt-2">
                <span>{area.link.text}</span>
                <span class="deco-arrow-r" aria-hidden="true"></span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- Zusammenarbeit -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">Zusammenarbeit</h2>
      <div class="space-y-4 text-text-secondary leading-relaxed">
        <p>
          Ein Auftrag beginnt mit einem bereitgestellten, lauffähigen Prototyp des
          angefragten Systems. Er verwendet Ihre Fachsprache, Beispieldaten, die Ihren
          echten ähneln, und die Arbeitsabläufe, die bei Ihnen tatsächlich vorkommen.
        </p>
        <p>
          Der Prototyp ist das Mittel, um sich auf die Spezifikation zu verständigen.
          Er ist nicht die Leistung selbst.
        </p>
        <p>
          Ich schließe den Vertrag direkt mit dem Auftraggeber, ohne Agentur oder
          Mittler dazwischen. Die Arbeit erfolgt remote, auf Deutsch oder Englisch.
        </p>
      </div>
    </section>

    <!-- Datenschutz und Barrierefreiheit -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">Datenschutz und Barrierefreiheit</h2>
      <div class="space-y-4 text-text-secondary leading-relaxed">
        <p>
          Ich arbeite EU-datenschutzkonform: Hosting in der EU oder in Deutschland,
          Auftragsverarbeitungsverträge mit allen Sub-Prozessoren und keine Bindung an
          US-Cloud-Dienste, wo sie vermeidbar ist.
        </p>
        <p>
          Ich entwickle nach WCAG 2.1 AA und prüfe das Ergebnis mit anerkannten
          Selbstbewertungsverfahren.
        </p>
      </div>
    </section>

    <!-- Was ich nicht anbiete -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">Was ich nicht anbiete</h2>
      <div class="bg-bg-secondary rounded-lg p-6">
        <ul class="divide-y divide-white/5">
          {notOffered.map((item) => (
            <li class="py-2.5 first:pt-0 last:pb-0 text-text-secondary">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Standort -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">Standort</h2>
      <p class="text-text-secondary leading-relaxed">
        Das Unternehmen ist in {legal.seat} registriert, die Geschäftsanschrift ist in
        {legal.city}, gearbeitet wird aus {legal.operativeCity}.
      </p>
    </section>

    <!-- Kontakt -->
    <section>
      <ContactCTA
        headline="Sie haben einen konkreten Bedarf?"
        description="Beschreiben Sie kurz, was Sie umsetzen möchten. Ich antworte in der Regel innerhalb eines Werktags."
        buttonText="Bedarf beschreiben"
        placeholder="Wir brauchen... / Wir möchten... / Wir suchen..."
        emailLabel="E-Mail"
        messageLabel="Worum geht es?"
        successMessage="Danke! Ich melde mich in Kürze."
        fallbackBefore="Oder schreiben Sie mir direkt an"
        sendingText="Wird gesendet..."
        errorText="Fehler, bitte erneut versuchen"
        subject="Neue Anfrage über 9592.tech/leistungen"
      />
    </section>
  </main>
</Layout>
