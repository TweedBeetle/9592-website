---
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { localizedPath, getLangFromUrl } from '../../i18n/utils';
import { caseStudies, caseStudyPath } from '../../data/work';

const lang = getLangFromUrl(Astro.url);

// Selected-work demonstrators (D4): surfaced first, each linking to its wrapped case
// study (internal, not an external live link). Titles/teasers mirror the work index
// in a homepage-length form. Keyed by stable study key; render order follows
// `caseStudies` (offer-map, editorial-workflow).
const cards: Record<string, { title: string; teaser: string }> = {
  'offer-map': {
    title: 'Angebotskarte für ein Beratungsnetzwerk',
    teaser:
      'Barrierearme, selbstaktualisierende Kartenanwendung mit Filtern, Umkreissuche und gleichwertiger Listenansicht.',
  },
  'editorial-workflow': {
    title: 'Redaktions-Workflow für einen öffentlichen Datenbestand',
    teaser:
      'Zweistufige Freigabe mit Diff-Anzeige, Audit-Log und automatisierten Erinnerungen.',
  },
};
---

<Layout pageKey="home">
  <main id="main" class="max-w-3xl mx-auto px-6 py-16 md:py-20">
    <!-- Hero -->
    <section class="mb-14">
      <div class="flex items-center gap-5 mb-5">
        <img
          src="/christo-wilken.jpg"
          alt="Christo Wilken"
          class="w-24 h-24 rounded-full object-cover"
        />
        <div class="-translate-y-[3px]">
          <h1 class="text-[30px] md:text-5xl font-semibold text-text-primary leading-tight">
            Christo Wilken
          </h1>
          <p class="font-mono text-sm text-text-secondary mt-1 ml-[3px]">9592 Solutions</p>
        </div>
      </div>
      <p class="text-xl text-text-secondary leading-relaxed mb-6">
        Ich entwickle individuelle, lauffähige Software. Statt eine Lösung nur zu
        beschreiben, baue ich einen funktionierenden Demonstrator, den Sie vor einer
        Beauftragung selbst prüfen können.
      </p>
      <a
        href="mailto:christo@9592.tech"
        class="inline-flex items-center gap-2 text-accent hover:text-accent-hover transition-colors"
      >
        <span>christo@9592.tech</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </section>

    <!-- Was ich mache -->
    <section class="mb-14">
      <h2 class="font-mono text-sm text-text-secondary mb-4 uppercase tracking-wider">Was ich mache</h2>
      <div class="space-y-4 text-text-secondary leading-relaxed">
        <p>
          Ich bin Christo Wilken und führe 9592 Solutions, einen inhabergeführten
          Softwareanbieter. Sie arbeiten direkt mit der Person zusammen, die die
          technische Gesamtverantwortung trägt, und haben einen einzigen
          Vertragspartner ohne Mittler.
        </p>
        <p>
          Ich entwickle über den gesamten Stack: Backends, Web- und mobile
          Anwendungen, Datenverarbeitung und die Infrastruktur für den
          Produktivbetrieb. Ob ein Vorhaben in der angedachten Form sinnvoll ist,
          sage ich Ihnen ehrlich, auch wenn die Antwort manchmal Nein lautet.
        </p>
      </div>
    </section>

    <!-- Leistungen -->
    <section class="mb-14">
      <h2 class="font-mono text-sm text-text-secondary mb-4 uppercase tracking-wider">Leistungen</h2>
      <div class="space-y-4 text-text-secondary leading-relaxed mb-5">
        <p>
          Für Auftraggeber mit strukturierten Vergabe- und Einkaufsprozessen liefere
          ich individuelle, lauffähige Software. Ein Auftrag beginnt mit einem
          lauffähigen Prototyp statt mit Foliensätzen: zentrale Ergebnisse sind vor
          der Vergabe prüfbar.
        </p>
      </div>
      <a href={localizedPath('leistungen', lang)} class="group flex items-center justify-between p-4 -mx-4 rounded-lg hover:bg-bg-secondary transition-colors">
        <div>
          <h3 class="text-text-primary font-medium mb-1 group-hover:text-accent transition-colors">
            Leistungen im Überblick
          </h3>
          <p class="text-text-secondary text-sm">
            Einzel-Prinzipal-Praxis, Direktvertrag, EU/DE-Datenschutz, Barrierefreiheit.
          </p>
        </div>
        <svg class="w-4 h-4 text-text-secondary/40 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </section>

    <!-- Ausgewählte Arbeiten -->
    <section class="mb-14">
      <h2 class="font-mono text-sm text-text-secondary mb-4 uppercase tracking-wider">Ausgewählte Arbeiten</h2>
      <ul class="space-y-4">
        {caseStudies.map((study) => (
          <li class="group">
            <a
              href={caseStudyPath(study, lang)}
              class="flex items-start justify-between gap-4 p-4 -mx-4 rounded-lg hover:bg-bg-secondary transition-colors"
            >
              <div>
                <p class="font-mono text-[11px] text-text-secondary uppercase tracking-wider mb-1.5">
                  Demonstrator / Arbeitsprobe
                </p>
                <h3 class="text-text-primary font-medium mb-1 group-hover:text-accent transition-colors">
                  {cards[study.key].title}
                </h3>
                <p class="text-text-secondary text-sm leading-relaxed">
                  {cards[study.key].teaser}
                </p>
              </div>
              <svg class="w-4 h-4 text-text-secondary/40 shrink-0 ml-4 mt-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </li>
        ))}
        <li class="group">
          <a href="https://askjeevesny.com" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-4 -mx-4 rounded-lg hover:bg-bg-secondary transition-colors">
            <div>
              <h3 class="text-text-primary font-medium mb-1 group-hover:text-accent transition-colors flex items-center gap-2">
                Jeeves Laundry Assistant
                <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-emerald-500/50 ml-1">
                  <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500/30 animate-[pulse_2s_cubic-bezier(0.4,0,0.6,1)_infinite]"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500/40 shadow-[0_0_6px_rgba(16,185,129,0.4)]"></span>
                  </span>
                  live
                </span>
              </h3>
              <p class="text-text-secondary text-sm">
                KI-Chatbot, trainiert auf über 400 Videos von @jeeves_ny, beantwortet Fragen zu Wäsche und Textilpflege.
              </p>
            </div>
            <svg class="w-4 h-4 text-text-secondary/40 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </li>
        <li class="group">
          <a href="https://ai-actions.app" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-4 -mx-4 rounded-lg hover:bg-bg-secondary transition-colors">
            <div>
              <h3 class="text-text-primary font-medium mb-1 group-hover:text-accent transition-colors">
                AI Actions
              </h3>
              <p class="text-text-secondary text-sm">
                iOS-App, die ChatGPT, DALL-E, Perplexity und Gemini über native Apple Kurzbefehle bereitstellt.
              </p>
            </div>
            <svg class="w-4 h-4 text-text-secondary/40 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </li>
        <li class="group">
          <a href="/Christo_Wilken_Masters_Thesis_LLM_Reasoning_TUM_2025.pdf" class="flex items-center justify-between p-4 -mx-4 rounded-lg hover:bg-bg-secondary transition-colors">
            <div>
              <h3 class="text-text-primary font-medium mb-1 group-hover:text-accent transition-colors">
                Masterarbeit
              </h3>
              <p class="text-text-secondary text-sm">
                Process Reward Models für mathematisches Schließen in LLMs. TU München, 2025.
              </p>
            </div>
            <svg class="w-4 h-4 text-text-secondary/40 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </a>
        </li>
      </ul>
    </section>

    <!-- Blog -->
    <section class="mb-14">
      <h2 class="font-mono text-sm text-text-secondary mb-4 uppercase tracking-wider">Schreiben</h2>
      <a href="/de/blog" class="group flex items-center justify-between p-4 -mx-4 rounded-lg hover:bg-bg-secondary transition-colors">
        <div>
          <h3 class="text-text-primary font-medium mb-1 group-hover:text-accent transition-colors">
            Blog
          </h3>
          <p class="text-text-secondary text-sm">
            Gedanken zu KI-Systemen, LLMs und Software, die in der Produktion funktioniert.
          </p>
        </div>
        <svg class="w-4 h-4 text-text-secondary/40 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </section>

    <!-- Kontakt -->
    <section>
      <ContactCTA
        headline="Sie haben ein Projekt im Kopf?"
        description="Beschreiben Sie kurz, woran Sie arbeiten. Ich melde mich innerhalb eines Tages."
        buttonText="Projekt beschreiben"
        placeholder="Ich baue... / Ich brauche Hilfe bei... / Ich suche..."
      />
    </section>

  </main>
</Layout>
