---
// On-demand root: redirect `/` by browser language (USER OVERRIDE).
// A real per-request decision (not Astro's static `redirectToDefaultLocale`):
// highest-priority Accept-Language tag with primary subtag `de` -> /de/, else -> /en/.
export const prerender = false;

import { pickLocaleFromAcceptLanguage } from '../i18n/utils';

const target = `/${pickLocaleFromAcceptLanguage(Astro.request.headers.get('accept-language'))}/`;

// 302 (target is request-dependent, must not be cached as permanent) + Vary so any
// cache layer (Cloudflare) keys the redirect per Accept-Language.
return new Response(null, {
  status: 302,
  headers: {
    Location: target,
    Vary: 'Accept-Language',
    'Cache-Control': 'no-store',
  },
});
---
