---
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { legal } from '../../i18n/legal';
import { courseSync, caseStudyPath } from '../../data/work';

// Procurement-facing capabilities page (PLAN D1), EN mirror of /de/leistungen.
// Copy source: findings §4.4, restructured to remove em dashes (site voice rule).
// Positioning per the PLAN "POSITIONING CORRECTION": owner-led provider with direct
// technical responsibility; the edge is the inspectable working demonstrator. AI is
// NOT a value proposition and is not named here. Entity facts come from
// src/i18n/legal.ts (register fact = Amtsgericht München); the location bridge uses
// the legal seat/city verbatim so there is a single source of truth.

const practiceAreas: { title: string; body: string; link?: { href: string; text: string } }[] = [
  {
    title: 'Application development for web and iOS',
    body: 'Web applications and native iOS apps, from the database up to the interface.',
  },
  {
    title: 'Internal tools',
    body: 'Software for the work your team currently does by hand or in spreadsheets.',
  },
  {
    title: 'Data pipelines',
    body: 'Getting data out of the systems that hold it, cleaning it up, and keeping it current.',
  },
  {
    title: 'Integration work',
    body: 'Connecting new software to the systems and interfaces you already run.',
  },
  {
    title: 'Make.com automation',
    body: 'Make.com scenarios between the tools a business already uses, such as a booking system, a CRM and a spreadsheet. I test them by running them in a live Make account.',
    link: { href: caseStudyPath(courseSync, 'en'), text: 'Example: course enrollments from MindBody to HubSpot' },
  },
];

const notOffered = [
  'Training and workshop delivery',
  "Renting out developer time inside someone else's process",
  "Large integration projects staffed with the CVs of people who won't do the work",
  'Hardware procurement',
];
---

<Layout
  pageKey="leistungen"
  title="Services · 9592 Solutions"
  description="Custom software for buyers with a formal procurement process. One developer, direct contracting, EU/DE data handling, WCAG 2.1 AA."
>
  <main id="main" class="max-w-3xl mx-auto px-6 py-16 md:py-20">
    <!-- Header -->
    <section class="mb-16">
      <p class="font-mono text-sm text-text-secondary mb-3 uppercase tracking-wider">Services</p>
      <h1 class="text-3xl md:text-4xl font-semibold text-text-primary leading-tight mb-6">
        Working software, built for your process
      </h1>
      <p class="text-lg text-text-secondary leading-relaxed">
        9592 Solutions is my company, and I do the technical work myself. You can
        open and test the main parts of the system you asked for before you award
        the contract.
      </p>
    </section>

    <!-- Practice areas -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">Practice areas</h2>
      <ul class="grid sm:grid-cols-2 gap-px bg-bg-secondary rounded-lg overflow-hidden border border-bg-secondary">
        {practiceAreas.map((area) => (
          <li class={`bg-bg-primary p-5${area.link ? ' sm:col-span-2' : ''}`}>
            <h3 class="text-text-primary font-medium mb-1">{area.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{area.body}</p>
            {area.link && (
              <a href={area.link.href} class="inline-flex items-center gap-2 text-accent hover:text-accent-hover transition-colors text-sm mt-2">
                <span>{area.link.text}</span>
                <span class="deco-arrow-r" aria-hidden="true"></span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- How an engagement works -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">How an engagement works</h2>
      <div class="space-y-4 text-text-secondary leading-relaxed">
        <p>
          An engagement starts with a deployed, working prototype of the system you
          asked for. It uses your own vocabulary, sample data that resembles yours,
          and the workflows your people actually run.
        </p>
        <p>
          The prototype is how we agree on the specification. It is not the
          deliverable itself.
        </p>
        <p>
          I contract directly with the buying entity, with no agency or intermediary
          in between. Work is done remotely, in German or English.
        </p>
      </div>
    </section>

    <!-- Data handling and accessibility -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">Data handling and accessibility</h2>
      <div class="space-y-4 text-text-secondary leading-relaxed">
        <p>
          I build to EU data-protection requirements: hosting in the EU or Germany,
          processor agreements with any sub-processors, and no dependency on US cloud
          services where that can be avoided.
        </p>
        <p>
          I build to WCAG 2.1 AA and check the result with recognised self-assessment
          methods.
        </p>
      </div>
    </section>

    <!-- What I do not do -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">What I do not do</h2>
      <div class="bg-bg-secondary rounded-lg p-6">
        <ul class="divide-y divide-white/5">
          {notOffered.map((item) => (
            <li class="py-2.5 first:pt-0 last:pb-0 text-text-secondary">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Location -->
    <section class="mb-16">
      <h2 class="font-mono text-sm text-text-secondary mb-5 uppercase tracking-wider">Location</h2>
      <p class="text-text-secondary leading-relaxed">
        The company is registered in {legal.seat}, has its business address in
        {legal.city}, and I work from {legal.operativeCity}.
      </p>
    </section>

    <!-- Contact -->
    <section>
      <ContactCTA
        headline="Have a defined need?"
        description="Tell me what you'd like to build. I usually reply within one business day."
        buttonText="Describe your need"
        placeholder="We need... / We're looking for... / We'd like to..."
      />
    </section>
  </main>
</Layout>
