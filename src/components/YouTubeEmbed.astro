---
// Responsive, lazy, privacy-enhanced YouTube embed (youtube-nocookie.com).
// Usage in MDX: import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
//               <YouTubeEmbed id="VIDEO_ID" title="Video title" />
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
const src = `https://www.youtube-nocookie.com/embed/${id}?rel=0`;
---
<figure class="yt-embed">
  <div class="yt-embed__frame">
    <iframe
      src={src}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>
</figure>

<style>
  .yt-embed {
    margin: 2rem 0 2.5rem;
  }
  .yt-embed__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #0b0f14;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  }
  .yt-embed__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
