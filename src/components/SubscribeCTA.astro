---
import { localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/routes';

interface Props {
  /** Locale for the component chrome (copy, labels, status). Defaults to 'en'. */
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

const privacyHref = localizedPath('datenschutz', lang);

// Copy (voice-playbook: plain, honest, no hype, no em dashes, complete sentences.
// DE matches the site register, which is Sie-Form across kontakt/datenschutz/BlogCTA).
const s =
  lang === 'de'
    ? {
        title: 'Gelegentliche Notizen zu KI in der Praxis',
        description:
          'Was sich in der KI-Entwicklung tut und was ich beim Bauen damit lerne. Kein Spam. Jederzeit abbestellbar.',
        emailLabel: 'E-Mail',
        emailPlaceholder: 'sie@beispiel.de',
        button: 'Abonnieren',
        sending: 'Wird abonniert...',
        errorRetry: 'Etwas ist schiefgelaufen. Bitte erneut versuchen',
        success:
          'Danke für Ihr Abonnement. Ich melde mich nur, wenn es etwas Sinnvolles zu senden gibt.',
        consentBefore:
          'Mit dem Abonnieren willigen Sie ein, gelegentlich E-Mail-Updates zu erhalten. Ihre Adresse wird nur dafür verwendet und nicht weitergegeben. Sie können sich jederzeit abmelden. Mehr in der',
        consentLink: 'Datenschutzerklärung',
        consentAfter: '.',
      }
    : {
        title: 'Occasional notes on AI in practice',
        description:
          'What is changing at the AI frontier and what I am learning building with it. No spam. Unsubscribe anytime.',
        emailLabel: 'Email',
        emailPlaceholder: 'you@example.com',
        button: 'Subscribe',
        sending: 'Subscribing...',
        errorRetry: 'Something went wrong. Please try again',
        success:
          'Thanks for subscribing. I will only email when there is something worth sending.',
        consentBefore:
          'By subscribing you consent to receiving occasional email updates. Your address is used only for this and is never shared. You can unsubscribe at any time. More in the',
        consentLink: 'privacy policy',
        consentAfter: '.',
      };

// Web3Forms access key (same account as BlogCTA/ContactCTA).
const WEB3FORMS_KEY = '99a20438-b99f-4305-a261-e32934e77a2a';

// Stable, machine-filterable notification metadata so newsletter signups are
// separable from inquiry submissions in the inbox, and trivially exportable when
// the list migrates to a real newsletter tool.
const SUBJECT = 'Newsletter signup, 9592.tech';
const FROM_NAME = '9592.tech Newsletter';
---

<section class="subscribe-cta" id="subscribe-cta-container" aria-labelledby="subscribe-cta-title">
  <h2 class="cta-headline" id="subscribe-cta-title">{s.title}</h2>
  <p class="cta-description">{s.description}</p>

  <form
    class="cta-form"
    id="subscribe-cta-form"
    action="https://api.web3forms.com/submit"
    method="POST"
    data-sending={s.sending}
    data-error={s.errorRetry}
  >
    <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
    <input type="hidden" name="subject" value={SUBJECT} />
    <input type="hidden" name="from_name" value={FROM_NAME} />
    <input type="hidden" name="list" value="newsletter" />
    <input type="hidden" name="locale" value={lang} />
    <input type="hidden" name="page_url" id="subscribe-page-url" value="" />

    <!-- Honeypot: hidden from users and assistive tech; aria-label keeps it from
         tripping the "form field needs a name" check. -->
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" aria-hidden="true" aria-label="Leave this field empty" />

    <div class="cta-row">
      <div class="form-field">
        <label for="subscribe-email">{s.emailLabel}</label>
        <input
          type="email"
          id="subscribe-email"
          name="email"
          placeholder={s.emailPlaceholder}
          autocomplete="email"
          required
        />
      </div>
      <button type="submit" class="cta-submit" id="subscribe-submit-btn">{s.button}</button>
    </div>
  </form>

  <p class="cta-consent" id="subscribe-consent">
    {s.consentBefore}
    <a href={privacyHref}>{s.consentLink}</a>{s.consentAfter}
  </p>

  <div class="cta-success" id="subscribe-success" style="display: none;">
    <p class="success-message">{s.success}</p>
  </div>
</section>

<style>
  .subscribe-cta {
    background: var(--color-bg-secondary);
    border-radius: 10px;
    padding: 28px 28px 24px;
    margin-top: 48px;
  }

  .cta-headline {
    font-size: 19px;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .cta-description {
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 20px;
  }

  .cta-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Email + button sit side by side on wider viewports, stack on narrow ones. */
  .cta-row {
    display: flex;
    gap: 10px;
    align-items: flex-end;
    flex-wrap: wrap;
  }

  .form-field {
    flex: 1 1 240px;
  }

  .form-field label {
    display: block;
    font-size: 12px;
    color: var(--color-text-secondary);
    margin-bottom: 5px;
    letter-spacing: 0.01em;
  }

  .form-field input {
    width: 100%;
    background: var(--color-bg-primary);
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 10px 12px;
    color: var(--color-text-primary);
    font-size: 14px;
    font-family: inherit;
    transition: border-color 0.15s;
  }

  .form-field input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-field input::placeholder {
    color: #4a4a4a;
  }

  .cta-submit {
    background: var(--color-accent-strong);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
    flex-shrink: 0;
  }

  .cta-submit:hover {
    background: var(--color-accent-strong-hover);
  }

  /* Touch devices: ensure a >=44px tap target. */
  @media (pointer: coarse) {
    .cta-submit {
      min-height: 44px;
    }
  }

  .cta-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .cta-consent {
    margin-top: 14px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .cta-consent a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cta-consent a:hover {
    color: var(--color-accent-hover);
  }

  /* Success state */
  .cta-success {
    padding: 20px 0 4px;
  }

  .success-message {
    color: #22c55e;
    font-size: 15px;
    font-weight: 500;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('subscribe-cta-form') as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = document.getElementById('subscribe-submit-btn') as HTMLButtonElement;
    const successDiv = document.getElementById('subscribe-success') as HTMLDivElement;
    const consentP = document.getElementById('subscribe-consent') as HTMLParagraphElement;
    const pageUrl = document.getElementById('subscribe-page-url') as HTMLInputElement;

    // Localized status strings (default to English when the attribute is absent).
    const sendingText = form.dataset.sending || 'Subscribing...';
    const errorText = form.dataset.error || 'Something went wrong. Please try again';

    if (pageUrl) pageUrl.value = window.location.href;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalText = submitBtn.textContent;
      submitBtn.textContent = sendingText;
      submitBtn.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          form.style.display = 'none';
          consentP.style.display = 'none';
          successDiv.style.display = 'block';
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch (error) {
        console.error('Subscribe submission error:', error);
        submitBtn.textContent = errorText;
        submitBtn.disabled = false;

        setTimeout(() => {
          submitBtn.textContent = originalText;
        }, 3000);
      }
    });
  });
</script>
