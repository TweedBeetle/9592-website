---
import { localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/routes';
import type { CaseStudy } from '../data/work/types';

interface Props {
  lang: Locale;
  study: CaseStudy;
  /** The anonymized (generic) title. Overridden by study.namedTitle when flipped. */
  title: string;
}

const { lang, study, title } = Astro.props;

// Section labels for the work section. Kept local to this component (NOT in ui.ts):
// they are case-study scaffolding, not global chrome. Voice-playbook checked, both
// languages: no superlatives, no em dashes, no emoji; DE Sie-Form.
const c = {
  de: {
    back: 'Alle Arbeiten',
    label: 'Demonstrator / Arbeitsprobe',
    labelDef:
      'Ein bereitgestellter, im Browser testbarer Prototyp als Arbeitsprobe. Kein Kundenprojekt, kein Produkt.',
    problem: 'Ausgangslage',
    approach: 'Vorgehen',
    demonstrates: 'Was der Demonstrator zeigt',
    client: 'Auftraggeber',
    requestHeadline: 'Live-Demo auf Anfrage',
    requestBody: 'Ich stelle Ihnen den Demonstrator gerne zum Testen bereit.',
    requestLink: 'Zugang anfragen',
    openLive: 'Live-Demo öffnen',
  },
  en: {
    back: 'All work',
    label: 'Demonstrator / work sample',
    labelDef:
      'A deployed prototype you can test in the browser, built as a work sample. Not a customer project, not a product.',
    problem: 'The problem',
    approach: 'The approach',
    demonstrates: 'What the demonstrator shows',
    client: 'Client',
    requestHeadline: 'Live demo on request',
    requestBody: 'I will gladly give you access to the demonstrator for testing.',
    requestLink: 'Request access',
    openLive: 'Open live demo',
  },
}[lang];

const displayTitle = study.anonymized ? title : (study.namedTitle?.[lang] ?? title);
const workIndexHref = localizedPath('arbeiten', lang);
const contactHref = localizedPath('kontakt', lang);
---

<main id="main" class="max-w-3xl mx-auto px-6 py-16 md:py-20">
  <a
    href={workIndexHref}
    class="inline-flex items-center gap-2 text-text-secondary hover:text-accent transition-colors mb-8"
  >
    <span class="deco-arrow-l" aria-hidden="true"></span>
    <span>{c.back}</span>
  </a>

  <!-- Label + title -->
  <header class="mb-12">
    <p class="font-mono text-xs text-text-secondary mb-4 uppercase tracking-wider">{c.label}</p>
    <h1 class="text-3xl md:text-4xl font-semibold text-text-primary leading-tight mb-4">
      {displayTitle}
    </h1>
    <p class="text-text-secondary text-sm leading-relaxed">{c.labelDef}</p>
    {!study.anonymized && study.buyerName && (
      <p class="text-text-secondary text-sm mt-3">
        {c.client}: <span class="text-text-primary">{study.buyerName}</span>
      </p>
    )}
  </header>

  <!-- Problem -->
  <section class="mb-14">
    <h2 class="font-mono text-sm text-text-secondary mb-4 uppercase tracking-wider">{c.problem}</h2>
    <div class="space-y-4 text-text-secondary leading-relaxed">
      <slot name="problem" />
    </div>
  </section>

  <!-- Approach -->
  <section class="mb-14">
    <h2 class="font-mono text-sm text-text-secondary mb-4 uppercase tracking-wider">{c.approach}</h2>
    <div class="space-y-4 text-text-secondary leading-relaxed">
      <slot name="approach" />
    </div>
  </section>

  <!-- Screenshots -->
  <section class="mb-14">
    <ul class="space-y-8 list-none p-0 m-0">
      {study.images.map((img) => (
        <li>
          <figure class="m-0">
            <img
              src={img.src}
              width={img.width}
              height={img.height}
              alt={img.alt[lang]}
              loading="lazy"
              decoding="async"
              class="work-shot"
            />
            <figcaption class="text-text-secondary text-sm mt-2.5 leading-relaxed">
              {img.caption[lang]}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <!-- What it demonstrates -->
  <section class="mb-14">
    <h2 class="font-mono text-sm text-text-secondary mb-4 uppercase tracking-wider">{c.demonstrates}</h2>
    <div class="space-y-4 text-text-secondary leading-relaxed">
      <slot name="demonstrates" />
    </div>
  </section>

  <!-- Live-demo affordance: win-flip controlled. Anonymized -> request access via the
       contact page (no buyer URL). Flipped -> a direct live-demo link. -->
  {study.anonymized ? (
    <aside class="demo-callout">
      <p class="demo-headline">{c.requestHeadline}</p>
      <p class="demo-body">{c.requestBody}</p>
      <a href={contactHref} class="demo-link">{c.requestLink} <span class="deco-arrow-r" aria-hidden="true"></span></a>
    </aside>
  ) : (
    study.liveUrl && (
      <aside class="demo-callout">
        <a href={study.liveUrl} target="_blank" rel="noopener noreferrer" class="demo-button">
          {c.openLive} <span class="deco-arrow-r" aria-hidden="true"></span>
        </a>
      </aside>
    )
  )}
</main>

<style>
  .work-shot {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    border: 1px solid var(--color-bg-secondary);
    background: var(--color-bg-secondary);
  }

  .demo-callout {
    background: var(--color-bg-secondary);
    border-radius: 10px;
    padding: 24px 28px;
  }

  .demo-headline {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 6px;
  }

  .demo-body {
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 14px;
  }

  .demo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent);
    font-size: 14px;
    text-decoration: none;
    border-radius: 4px;
  }

  .demo-link:hover { color: var(--color-accent-hover); }

  .demo-link:focus-visible,
  .demo-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .demo-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: 6px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .demo-button:hover { background: var(--color-accent-hover); }
</style>
