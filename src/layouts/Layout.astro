---
// Self-hosted fonts (no Google Fonts CDN; latin subset covers DE + EN, incl. äöüß).
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import { getLangFromUrl, localizedPath } from '../i18n/utils';
import type { Locale, PageKey } from '../i18n/routes';
import { legal } from '../i18n/legal';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Enables hreflang alternates built from the route-map (PC1). */
  pageKey?: PageKey;
  /** Explicit locale override; otherwise derived from the URL prefix. */
  lang?: Locale;
}

const lang: Locale = Astro.props.lang ?? getLangFromUrl(Astro.url);

const {
  title = '9592 Solutions',
  description = lang === 'de'
    ? 'KI-Systeme und Softwareentwicklung von Christo Wilken'
    : 'AI systems and software development by Christo Wilken',
  ogType = 'website',
  pageKey,
} = Astro.props;

const ogLocale = lang === 'de' ? 'de_DE' : 'en_US';
const ogLocaleAlt = lang === 'de' ? 'en_US' : 'de_DE';

// hreflang alternates (PC1 route-map). x-default -> /en per the USER OVERRIDE.
const alternates = pageKey
  ? {
      de: new URL(localizedPath(pageKey, 'de'), Astro.site).href,
      en: new URL(localizedPath(pageKey, 'en'), Astro.site).href,
    }
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- hreflang alternates (x-default -> /en) -->
    {alternates && (
      <>
        <link rel="alternate" hreflang="de" href={alternates.de} />
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="x-default" href={alternates.en} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="9592 Solutions" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Theme color -->
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Structured Data (entity facts sourced from src/i18n/legal.ts) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "9592 Solutions",
      "legalName": legal.legalName,
      "url": "https://9592.tech",
      "description": "AI systems and software development",
      "email": legal.email,
      "vatID": legal.vatId,
      "founder": {
        "@type": "Person",
        "name": "Christo Wilken",
        "email": legal.email
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": legal.street,
        "postalCode": legal.postalCode,
        "addressLocality": legal.city,
        "addressCountry": legal.countryCode
      },
      "areaServed": "Worldwide"
    })} />
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
